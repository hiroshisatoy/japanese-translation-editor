{
  "name": "japanese-translation-editor",
  "private": true,
  "scripts": {
    "build": "esbuild ui.jsx --bundle --minify --outfile=dist/wp-ui.js --loader:.woff2=file --loader:.woff=file --loader:.ttf=file",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "start": "python3 -m http.server 8080 --bind 127.0.0.1",
    "test": "node test/ui.cjs"
  },
  "dependencies": {
    "@wordpress/components": "44.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2"
  }
}
